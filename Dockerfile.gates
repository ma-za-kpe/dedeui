FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS checked
WORKDIR /app
COPY . .
RUN node infra/check-repository.mjs

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=dede-ui-npm,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund --fetch-retries=1 --fetch-timeout=30000

FROM deps AS verified
ENV NEXT_TELEMETRY_DISABLED=1 CI=1
COPY --from=checked /app/ ./
RUN npm exec eslint -- --max-warnings=0 .
RUN bash -n infra/precommit.sh && sh -n .githooks/pre-commit
RUN node --experimental-strip-types --test 'tests/*.test.mjs'
ARG AUDIT_EPOCH
RUN test -n "$AUDIT_EPOCH"
RUN npm audit --audit-level=high
RUN npm run build

# Keep the gate result tiny; validation dependencies remain rebuildable cache.
FROM scratch
COPY --from=verified /app/.next/BUILD_ID /BUILD_ID
