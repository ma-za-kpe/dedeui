FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /audit
RUN npm install playwright@1.56.1 @axe-core/playwright@4.10.2 && ./node_modules/.bin/playwright install --with-deps --only-shell chromium
COPY tests/browser-audit.mjs /audit/browser-audit.mjs
CMD ["node", "/audit/browser-audit.mjs"]
